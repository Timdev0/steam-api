# Base URL of the backend API (no trailing slash).
#
# Leave this UNSET for local dev: Vite's dev server proxies /api to
# http://localhost:3000 (see vite.config.ts), so relative calls just work.
#
# Set it when building for production (e.g. on Vercel), pointing to your
# deployed backend (e.g. Render):
VITE_API_URL=https://your-backend.onrender.com
